# Local dev values go in backend/.env (already gitignored-worthy — see note below).
# For Render, set these same keys as environment variables in the dashboard instead
# of shipping a .env file with the container.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=SkillSwap
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Generate a fresh one for production - never reuse a secret that has ever been
# committed to git history. One-liner: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=replace_me_with_a_freshly_generated_random_string
JWT_TTL=3600
JWT_ISSUER=SkillSwap

LOGIN_RATE_LIMIT=5
LOGIN_WINDOW_SECONDS=60

# Comma-separated whitelist of origins allowed to call this API.
# Leave unset locally to allow any origin. In production, set it to your
# deployed frontend's exact URL (no trailing slash).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
